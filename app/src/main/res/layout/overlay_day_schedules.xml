<?xml version="1.0" encoding="utf-8"?>
<com.geekathon.guardpet.OverlaySideRoot xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/importCalendarButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/flash_write_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/schedule_import_calendar"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/closeScheduleOverlayButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/flash_write_pill"
            android:contentDescription="@string/close_menu"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/scheduleEmptyHint"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:background="@drawable/flash_write_pill"
        android:padding="12dp"
        android:text="@string/schedule_empty_hint"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/scheduleFillPanel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/flash_write_pill"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/schedule_fill_time_title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/schedule_fill_time_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/scheduleFillRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/scheduleFillVoiceButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/flash_write_pill"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/schedule_hold_voice_time"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/scheduleFillConfirmButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/flash_write_pill"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/schedule_confirm_times"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxHeight="520dp">

        <LinearLayout
            android:id="@+id/scheduleCards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</com.geekathon.guardpet.OverlaySideRoot>
