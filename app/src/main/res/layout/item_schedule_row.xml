<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scheduleRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:background="@drawable/card_background"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="11dp"
    android:paddingEnd="8dp"
    android:paddingBottom="11dp">

    <View
        android:id="@+id/scheduleRowColor"
        android:layout_width="5dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/flash_color_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/scheduleRowTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/scheduleRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/scheduleRowPolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/scheduleRowDone"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/schedule_mark_done"
        android:padding="10dp"
        android:src="@drawable/ic_check_line"
        android:tint="@color/brand_primary" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/scheduleRowEdit"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/schedule_edit"
        android:padding="10dp"
        android:src="@drawable/ic_tune"
        android:tint="@color/text_secondary" />
</LinearLayout>
