<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="Widget.GuardPet.Button" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/control_text</item>
    </style>
    <style name="Widget.GuardPet.Button.primary" parent="Widget.GuardPet.Button">
        <item name="android:background">@drawable/primary_button</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="Widget.GuardPet.Button.secondary" parent="Widget.GuardPet.Button">
        <item name="android:background">@drawable/secondary_button</item>
        <item name="android:textColor">@color/control_text</item>
    </style>
    <style name="Widget.GuardPet.Button.ghost" parent="Widget.GuardPet.Button">
        <item name="android:background">@drawable/ghost_button</item>
        <item name="android:textColor">@color/control_text</item>
    </style>
</resources>